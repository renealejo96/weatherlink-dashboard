# ============================================================================
# CONFIGURACIÓN DE PRODUCCIÓN PARA HOSTINGER VPS
# ============================================================================
# Proyecto aislado: weatherlink_prod
# No toca los puertos 80, 443 ni 8080 de tus otras aplicaciones.

# ============================================================================
# DOMINIOS Y PUERTOS
# ============================================================================
DOMAIN=weather.velezrapp.cloud

# Puerto donde la app Flask responde al Nginx del host (127.0.0.1:8090)
HOST_PORT=8090

# Redpanda Console (solo en 127.0.0.1 para acceso seguro vía túnel SSH)
REDPANDA_CONSOLE_PORT=18082

# ============================================================================
# API KEYS DE WEATHERLINK (Davis Instruments)
# ============================================================================
FINCA1_API_KEY=tu_api_key_finca1
FINCA1_API_SECRET=tu_api_secret_finca1
FINCA1_STATION_ID=167591

FINCA2_API_KEY=tu_api_key_finca2
FINCA2_API_SECRET=tu_api_secret_finca2
FINCA2_STATION_ID=209314

FINCA3_API_KEY=tu_api_key_finca3
FINCA3_API_SECRET=tu_api_secret_finca3
FINCA3_STATION_ID=219603

# Intervalo de sondeo a la API de Weatherlink en segundos (default: 270)
POLL_INTERVAL_SEC=270

# ============================================================================
# SUPABASE
# ============================================================================
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_service_role_o_anon_key

# ============================================================================
# REDPANDA (KAFKA) & REDIS (100% internos en la red privada de Docker)
# ============================================================================
KAFKA_BOOTSTRAP_SERVERS=redpanda:29092
KAFKA_TOPIC_RAW=weatherlink.raw
REDIS_URL=redis://redis:6379/0

# ============================================================================
# UMBRALES DE LLUVIA
# ============================================================================
RAIN_START_THRESHOLD=0.2
NO_RAIN_TIMEOUT_MINUTES=30
MAX_EVENT_DURATION_MINUTES=720

# ============================================================================
# FLASK APPLICATION & SEGURIDAD
# ============================================================================
SECRET_KEY=CAMBIAR_POR_CLAVE_ALEATORIA_HEX_64
FLASK_ENV=production
FLASK_DEBUG=0
TZ=America/Guayaquil
LOG_LEVEL=INFO
